1120 LOOP UNTIL fileNo > 0 or file_name = ""
1130 IF fileNo > 0 THEN
1140   fileClose(fileNo)
1150   PRINT "number of intervals"; : INPUT nIntervals
1160   REM Initialize the interval counters 
1170   FOR k = 0 TO nIntervals-1
1180     count[k] <- 0
1190   NEXT k
1200   REM Index of the most populated interval 
1210   kMaxCount <- 0
1220   numberArray <- {}
1230   nObtained <- 0
1240   ON ERROR GOTO 1280
1250   nObtained <- readNumbers(file_name, numberArray, 10000)
1260   GOTO 1300
1270   REM Start of error handler, FIXME: variable 'failure' should conatain error info ... 
1280     PRINT failure
1290   REM End of error handler, resume here ... 
1300   ON ERROR GOTO 0
1310   IF nObtained > 0 THEN
1320     min <- numberArray[0]
1330     max <- numberArray[0]
1340     FOR i = 1 TO nObtained-1
1350       IF numberArray[i] < min THEN
1360         min <- numberArray[i]
1370       ELSE
1380         IF numberArray[i] > max THEN
1390           max <- numberArray[i]
1400         END IF
1410       END IF
1420     NEXT i
1430     REM Interval width 
1440     width <- (max - min) * 1.0 / nIntervals
1450     FOR i = 0 TO nObtained - 1
1460       value <- numberArray[i]
1470       k <- 1
1480       DO WHILE k < nIntervals and value > min + k * width
1490         k <- k + 1
1500       LOOP
1510       count[k-1] <- count[k-1] + 1
1520       IF count[k-1] > count[kMaxCount] THEN
1530         kMaxCount <- k-1
1540       END IF
1550     NEXT i
1560     CALL drawBarChart(count, nIntervals)
1570     PRINT "Interval with max count: "; kMaxCount; " ("; count[kMaxCount]; ")"
1580     FOR k = 0 TO nIntervals-1
1590       PRINT count[k]; " numbers in interval "; k; " ("; min + k * width; " ... "; min + (k+1) * width; ")"
1600     NEXT k
1610   ELSE
1620     PRINT "No numbers read."
1630   END IF
1640 END IF
