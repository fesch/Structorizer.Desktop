1670 REM Draws a bar chart from the array "values" of size nValues. 
1680 REM Turtleizer must be activated and will scale the chart into a square of 
1690 REM 500 x 500 pixels 
1700 REM Note: The function is not robust against empty array or totally equal values. 
1710 REM TODO: Add type-specific suffixes where necessary! 
1720 SUB drawBarChart(values AS double(50), nValues)
1730   REM TODO: add the respective type suffixes to your variable names if required 
1740   REM  
1750   REM  
1760   REM Used range of the Turtleizer screen 
1770   CONST xSize <- 500
1780   CONST ySize <- 500
1790   kMin <- 0
1800   kMax <- 0
1810   FOR k = 1 TO nValues-1
1820     IF values[k] > values[kMax] THEN
1830       kMax <- k
1840     ELSE
1850       IF values[k] < values[kMin] THEN
1860         kMin <- k
1870       END IF
1880     END IF
1890   NEXT k
1900   valMin <- values[kMin]
1910   valMax <- values[kMax]
1920   yScale <- valMax * 1.0 / (ySize - 1)
1930   yAxis <- ySize - 1
1940   IF valMin < 0 THEN
1950     IF valMax > 0 THEN
1960       yAxis <- valMax * ySize * 1.0 / (valMax - valMin)
1970       yScale <- (valMax - valMin) * 1.0 / (ySize - 1)
1980     ELSE
1990       yAxis <- 1
2000       yScale <- valMin * 1.0 / (ySize - 1)
2010     END IF
2020   END IF
2030   REM draw coordinate axes 
2040   gotoXY(1, ySize - 1)
2050   forward(ySize -1) : REM color = ffffff
2060   penUp()
2070   backward(yAxis) : REM color = ffffff
2080   right(90)
2090   penDown()
2100   forward(xSize -1) : REM color = ffffff
2110   penUp()
2120   backward(xSize-1) : REM color = ffffff
2130   stripeWidth <- xSize / nValues
2140   FOR k = 0 TO nValues-1
2150     stripeHeight <- values[k] * 1.0 / yScale
2160     SELECT CASE k mod 3
2170       CASE 0
2180         setPenColor(255,0,0)
2190       CASE 1
2200         setPenColor(0, 255,0)
2210       CASE 2
2220         setPenColor(0, 0, 255)
2230     END SELECT
2240     fd(1) : REM color = ffffff
2250     left(90)
2260     penDown()
2270     fd(stripeHeight) : REM color = ffffff
2280     right(90)
2290     fd(stripeWidth - 1) : REM color = ffffff
2300     right(90)
2310     forward(stripeHeight) : REM color = ffffff
2320     left(90)
2330     penUp()
2340   NEXT k
2350 END SUB

