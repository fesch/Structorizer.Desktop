2790 REM  
2800 REM Checks whether newInput has occurred among the recently cached 
2810 REM input strings in the histArray component of history and updates the history. 
2820 REM TODO: Add type-specific suffixes where necessary! 
2830 FUNCTION checkRepetition(history AS History, newInput AS String) AS boolean
2840   REM TODO: add the respective type suffixes to your variable names if required 
2850   REM  
2860   REM  
2870   hasOccurred <- false
2880   IF length(newInput) > 4 THEN
2890     histDepth <- length(history.histArray)
2900     FOR i = 0 TO histDepth-1
2910       IF newInput = history.histArray[i] THEN
2920         hasOccurred <- true
2930       END IF
2940     NEXT i
2950     history.histArray[history.histIndex] <- newInput
2960     history.histIndex <- (history.histIndex + 1) mod (histDepth)
2970   END IF
2980   RETURN hasOccurred
2990 END FUNCTION
3000 REM  
3010 REM Looks for the occurrence of the first of the strings 
3020 REM contained in keywords within the given sentence (in 
3030 REM array order). 
3040 REM Returns an array of 
3050 REM 0: the index of the first identified keyword (if any, otherwise -1), 
3060 REM 1: the position inside sentence (0 if not found) 
3070 REM TODO: Add type-specific suffixes where necessary! 
3080 FUNCTION findKeyword(CONST keyMap AS KeyMapEntry(50), sentence AS String) AS integer(0 TO 1)
3090   REM TODO: add the respective type suffixes to your variable names if required 
3100   REM  
3110   REM  
3120   REM Contains the index of the keyword and its position in sentence 
3130   result <- {-1, 0}
3140   i <- 0
3150   DO WHILE (result[0] < 0) and (i < length(keyMap))
3160     var entry: KeyMapEntry <- keyMap[i]
3170     position <- pos(entry.keyword, sentence)
3180     IF position > 0 THEN
3190       result[0] <- i
3200       result[1] <- position
3210     END IF
3220     i <- i+1
3230   LOOP
3240   RETURN result
3250 END FUNCTION
