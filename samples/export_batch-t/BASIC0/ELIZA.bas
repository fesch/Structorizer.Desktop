1450 REM  
1460 REM TODO: Add type-specific suffixes where necessary! 
1470 FUNCTION conjugateStrings(sentence AS String, key AS String, keyPos AS integer, flexions AS String(50,0 TO 1)) AS String
1480   REM TODO: add the respective type suffixes to your variable names if required 
1490   REM  
1500   REM  
1510   result <- " " + copy(sentence, keyPos + length(key), length(sentence)) + " "
1520   FOR EACH pair IN flexions
1530     left <- ""
1540     right <- result
1550     pos0 <- pos(pair[0], right)
1560     pos1 <- pos(pair[1], right)
1570     DO WHILE pos0 > 0 or pos1 > 0
1580       REM Detect which of the two words of the pair matches first (lest a substitution should be reverted) 
1590       which <- 0
1600       position <- pos0
1610       IF (pos0 = 0) or ((pos1 > 0) and (pos1 < pos0)) THEN
1620         which <- 1
1630         position <- pos1
1640       END IF
1650       left <- left + copy(right, 1, position-1) + pair[1 - which]
1660       right <- copy(right, position + length(pair[which]), length(right))
1670       pos0 <- pos(pair[0], right)
1680       pos1 <- pos(pair[1], right)
1690     LOOP
1700     result <- left + right
1710   NEXT pair
1720   REM Eliminate multiple spaces (replaced by single ones) and vertical bars 
1730   FOR EACH str IN {"  ", "|"}
1740     position <- pos(str, result)
1750     DO WHILE position > 0
1760       result <- copy(result, 1, position-1) + copy(result, position+1, length(result))
1770       position <- pos(str, result)
1780     LOOP
1790   NEXT str
1800   RETURN result
1810 END FUNCTION
1820 REM  
1830 REM Converts the sentence to lowercase, eliminates all 
1840 REM interpunction (i.e. ',', '.', ';'), and pads the 
1850 REM sentence among blanks 
1860 REM TODO: Add type-specific suffixes where necessary! 
1870 FUNCTION normalizeInput(sentence AS String) AS String
1880   REM TODO: add the respective type suffixes to your variable names if required 
1890   REM  
1900   REM  
1910   sentence <- lowercase(sentence)
1920   FOR EACH symbol IN {'.', ',', ';', '!', '?'}
1930     position <- pos(symbol, sentence)
1940     DO WHILE position > 0
1950       sentence <- copy(sentence, 1, position-1) + copy(sentence, position+1, length(sentence))
1960       position <- pos(symbol, sentence)
1970     LOOP
1980   NEXT symbol
1990   result <- " " + sentence + " "
2000   RETURN result
2010 END FUNCTION
